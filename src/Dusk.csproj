<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Dusk.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Dusk</AssemblyName>
    <Version>0.1.0</Version>
    <Product>Dusk</Product>
    <Description>Warm screen. Calm eyes.</Description>
    <Copyright>MIT, s-azizkhan</Copyright>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fonts/*.ttf" LogicalName="%(Filename)%(Extension)" />
    <None Include="Fonts/OFL.txt" CopyToPublishDirectory="Never" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
